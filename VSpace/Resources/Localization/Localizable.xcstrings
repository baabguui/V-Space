    "capture.alert.cancel.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All captured data will be deleted.\nAre you sure you want to cancel?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재까지 캡쳐된 사항은 모두 삭제됩니다.\n정말 취소하시겠습니까?"
          }
        }
      }
    },
    "capture.alert.cancel.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
